# Replies and image generation use any OpenAI-compatible API.
# Copy this file to .env and fill in your values. The key stays on the server.

# API key for the provider. Leave empty only for a local server with OPENAI_REQUIRE_KEY=false.
OPENAI_API_KEY=

# Custom base URL. Point this at OpenAI, OpenRouter, Groq, Together, Ollama, LM Studio, vLLM…
# Examples:
#   https://api.openai.com/v1
#   https://openrouter.ai/api/v1
#   http://127.0.0.1:11434/v1        (Ollama)
#   http://127.0.0.1:1234/v1         (LM Studio)
# A full endpoint such as https://api.openai.com/v1/chat/completions also works.
OPENAI_BASE_URL=https://api.openai.com/v1

# Chat model name, exactly as the provider expects it.
OPENAI_MODEL=gpt-4o-mini

# Image generation model. Set to a model your provider supports (e.g. gpt-image-1, dall-e-3).
# Leave empty to disable image generation and answer image requests in text.
OPENAI_IMAGE_MODEL=gpt-image-1

# Set to false to allow unauthenticated providers such as a local Ollama server.
OPENAI_REQUIRE_KEY=true

# Port for the app (default: 3000)
PORT=3000
